PDF_SERVICE_HOST=0.0.0.0
PDF_SERVICE_PORT=5000
TEMPLATE_DIR=templates
UPLOAD_DIR=uploads
MAX_PAPER_SIZE=50MB

FLASK_APP=app.py
FLASK_ENV=development
DEBUG=false

LOG_LEVEL=INFO
LOG_FILE=logs/pdf_service_flask.log
ALLOWED_ORIGINS=http://localhost:5173
CORS_ENABLED=true
MAX_WORKERS=4
REQUEST_TIMEOUT=30

